# Byte-compiled
__pycache__/
*.pyc
*.pyo

# Virtual env
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Large/regenerated (optional)
# results/*.json
# docs/figures/*.png

# Frontend (web/) — node_modules and build output never committed; data is regenerated.
web/node_modules/
web/dist/
web/public/data/*
# Exception: Stage 3 retrieval table is small + canonical numbers; commit
# it so the deployed frontend works without re-running the build script.
# Regenerated by scripts/build_stage3_frontend_data.py.
!web/public/data/stage3_retrieval.json
!web/public/data/stage3_phase4.json
!web/public/data/stage3_lambda.json
!web/public/data/stage3_ksweep.json
!web/public/data/stage3_finbench_corpus.json
!web/public/data/stage3_qasper_corpus.json
!web/public/data/stage3_cuad_corpus.json
!web/public/data/stage3_hotpotqa_corpus.json
!web/public/data/stage3_longmemeval_corpus.json
!web/public/data/stage3_narrativeqa_corpus.json
# Stage 3 Phase 2 graph evolution viewer data (regenerated by
# scripts/build_graph_evolution_frontend.py from results/stage3/corpus_traces/).
!web/public/data/graph_evolution/
!web/public/data/graph_evolution/**
web/.vite/

# Misc
results/checkpoints/

# Stage 3 benchmark caches — multi-GB, regenerated by scripts/prefetch_benchmarks.py
data/benchmarks/
.cache/huggingface/

# API keys and local secrets — NEVER commit
.env
.env.*
.env_local
*.key

# QASPER calibration corpus traces too large for GitHub (200+ MB)
results/stage3/corpus_traces/qasper__*__calibration/
# Large QASPER dump-all queue files (106+ MB, exceed GitHub limit)
results/stage3/judge_queue/qasper__dump-all__*calib*/queue.jsonl

# Stray log files (e.g. accidental redirects)
*.log
# Local Claude Code session/settings + git worktrees — never part of the repo
.claude/
# Local submission deliverables (the PDF lives at thesis/main.pdf; these are
# packaged copies + zip, regenerated on demand)
/submission/
/Uifalean_Stefan_3310360_MSc_AI_Thesis_submission/
/Uifalean_Stefan_3310360_MSc_AI_Thesis_submission.zip
